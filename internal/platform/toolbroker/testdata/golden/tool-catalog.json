    {
      "key": "workflow_propose@v1",
      "name": "workflow_propose",
      "version": "v1",
      "server": "",
      "plugin": false,
      "description": "Propose a workflow for the owner to approve; nothing runs until they do. Send spec with goal and steps. Each step has an id, an executor, and optional depends_on, condition and retry. Executor kinds: tool runs a registered tool with args matching that tool's schema; agent runs one read-only turn of persona agent_id over its dependencies' outputs; approval waits for the owner; wait pauses for an event; workflow runs another workflow. An agent step's tools come from read_file, list_dir, web_search, web_fetch, and may not mix workspace tools (read_file, list_dir) with web tools. A step with web tools may not depend on a private step: any tool step other than web_search and web_fetch, an agent step with workspace tools, or an agent step downstream of one. A tool step that changes things needs an approval step among its predecessors. Example: {\"spec\":{\"goal\":\"Summarize the latest Go release news\",\"steps\":[{\"id\":\"search\",\"executor\":{\"kind\":\"tool\",\"tool\":\"web_search\",\"args\":{\"query\":\"Go release news\"}}},{\"id\":\"summary\",\"depends_on\":[\"search\"],\"executor\":{\"kind\":\"agent\",\"agent_id\":\"main\",\"prompt\":\"Summarize the search results in five bullet points.\"}}]}}",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "aura://tools/workflow_propose/v1",
        "type": "object",
        "properties": {
          "spec": {
            "type": "object",
            "properties": {
              "goal": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "run_as": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                    },
                    "executor": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "tool"
                            },
                            "tool": {
                              "type": "string",
                              "minLength": 1
                            },
                            "args": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "kind",
                            "tool"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "agent"
                            },
                            "agent_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "prompt": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 2000
                            },
                            "tools": {
                              "type": "array",
                              "items": {
                                "enum": [
                                  "read_file",
                                  "list_dir",
                                  "web_search",
                                  "web_fetch"
                                ]
                              }
                            },
                            "output": {
                              "enum": [
                                "text",
                                "json"
                              ]
                            },
                            "max_tokens": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 200000
                            }
                          },
                          "required": [
                            "kind",
                            "agent_id",
                            "prompt"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "approval"
                            }
                          },
                          "required": [
                            "kind"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "wait"
                            },
                            "event": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128
                            },
                            "source": {
                              "type": "string",
                              "minLength": 1
                            },
                            "external_ref": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "event"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "workflow"
                            },
                            "workflow": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "kind",
                            "workflow"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    "depends_on": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "condition": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256,
                      "description": "steps.\u003cid\u003e.status or steps.\u003cid\u003e.output.\u003ckey\u003e compared with == or != to a literal, joined by \u0026\u0026"
                    },
                    "retry": {
                      "type": "object",
                      "properties": {
                        "attempts": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 5
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "id",
                    "executor"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "goal",
              "steps"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "spec"
        ],
        "additionalProperties": false
      },
