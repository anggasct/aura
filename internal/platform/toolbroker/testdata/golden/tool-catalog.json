{
  "policy_version": "builtin-tools-v1",
  "definitions": [
    {
      "key": "aura_cron_add@v1",
      "name": "aura_cron_add",
      "version": "v1",
      "server": "",
      "plugin": false,
      "description": "Create a scheduled job and start its run\n\nStores a prompt or workflow start that later runs unattended with the owner's authority. Its output goes to the owner's destination.",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "aura://operations/cron.add/v1",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "job name"
          },
          "schedule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "five-field cron expression"
          },
          "timezone": {
            "type": "string",
            "maxLength": 64,
            "description": "IANA timezone (default from config)"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536,
            "description": "turn prompt"
          },
          "workflow": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "workflow or routine id to start instead of a prompt"
          },
          "input": {
            "type": "object",
            "properties": {
              "objective": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "overlap": {
            "type": "string",
            "enum": [
              "skip",
              "queue_one"
            ],
            "description": "overlap policy",
            "default": "skip"
          },
          "grace": {
            "type": "string",
            "pattern": "^\\d+(ns|us|ms|s|m|h)(\\d+(ns|us|ms|s|m|h))*$",
            "description": "catch-up grace (default from config)"
          }
        },
        "required": [
          "name",
          "schedule"
        ],
        "additionalProperties": false
      },
      "required_capabilities": null,
      "requires_approval": true,
      "effectful": true,
      "opt_in": true,
      "owner_opt_in": true,
      "external_sink": true,
      "no_standing_grant": true,
      "exact_display": true,
      "orchestration": false,
      "display": [
        "name",
        "schedule",
        "timezone",
        "prompt",
        "workflow",
        "input",
        "overlap",
        "grace"
      ],
      "has_validator": false,
      "risk": "trust_grant",
      "operation": "cron.add",
      "fresh_approval": false,
      "owner_notice": false,
      "untrusted_output": false
    },
