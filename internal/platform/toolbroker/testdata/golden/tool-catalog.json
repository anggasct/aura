{
  "policy_version": "builtin-tools-v1",
  "definitions": [
    {
      "key": "code_execute@v1",
      "name": "code_execute",
      "version": "v1",
      "server": "",
      "plugin": false,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "aura://tools/code_execute/v1",
        "type": "object",
        "properties": {
          "runtime": {
            "type": "string",
            "enum": [
              "python",
              "javascript",
              "go"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "stdin": {
            "type": "string"
          },
          "output_files": {
            "type": "array",
            "description": "Relative file names written under the output/ directory of the working directory. Each existing regular file is imported as an artifact.",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+){0,3}$"
            }
          }
        },
        "required": [
          "runtime",
          "source"
        ],
        "additionalProperties": false
      },
      "required_capabilities": [
        "code-interpreter"
      ],
      "requires_approval": true,
      "effectful": true,
      "opt_in": false,
      "external_sink": false,
      "no_standing_grant": false,
      "exact_display": false,
      "orchestration": false,
      "display": null,
      "has_validator": false
    },
