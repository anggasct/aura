internal/platform/turn/engine -> internal/modules/skills  # engine renders skills until skills provide turn context
internal/modules/github -> internal/channels/webhook  # github consumes the webhook contract until it moves to the platform
internal/modules/github -> internal/modules/workflow  # github starts workflows until it uses a starter port
internal/modules/builtin -> internal/modules/codeexec  # builtin assembles tool adapters until each module provides its tools
internal/modules/builtin -> internal/modules/fetch  # builtin assembles tool adapters until each module provides its tools
internal/modules/builtin -> internal/modules/filesystem  # builtin assembles tool adapters until each module provides its tools
internal/modules/builtin -> internal/modules/search  # builtin assembles tool adapters until each module provides its tools
internal/modules/builtin -> internal/modules/shellexec  # builtin assembles tool adapters until each module provides its tools
internal/channels/discord -> internal/modules/memory  # discord tests use the memory recorder until they take a port
internal/cli -> internal/channels/terminal  # stderr error sanitizer until the channels step moves it out of the terminal channel
